    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "on-demand loading",
      "not eagerly loaded"
    ],
    "answerable": true
  },
  {
    "id": "Q007",
    "category": "preprocessing",
    "question": "What does to_lowercase() do?",
