    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "one-character tokens removed"
    ],
    "answerable": true
  },
  {
    "id": "Q015",
    "category": "preprocessing",
    "question": "Does preprocess_text() always remove stopwords?",
