      "src/preprocessing.py"
    ],
    "expected_points": [
      "whitespace split",
      "length greater than one"
    ],
    "answerable": true
  },
  {
    "id": "Q014",
    "category": "preprocessing",
    "question": "Does tokenize() retain one-character tokens?",
