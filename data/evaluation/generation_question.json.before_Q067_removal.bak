    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "warning",
      "empty set"
    ],
    "answerable": true
  },
  {
    "id": "Q006",
    "category": "preprocessing",
    "question": "Why is stopword loading lazy in this module?",
