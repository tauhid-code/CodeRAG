[
  {
    "id": "Q001",
    "category": "preprocessing",
    "question": "What is the purpose of the preprocessing module?",
    "reference_answer": "It provides text cleaning and normalization utilities for resume and job-description text before extraction.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "resume and job-description text",
      "cleaning/normalization",
      "before extraction"
    ],
    "answerable": true
  },
  {
    "id": "Q002",
    "category": "preprocessing",
    "question": "Which words are explicitly preserved when stopwords are removed?",
    "reference_answer": "The module preserves the words 'not', 'no', 'c', and 'r' by excluding them from the stopword set.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "not",
      "no",
      "c",
      "r"
    ],
    "answerable": true
  },
  {
    "id": "Q003",
    "category": "preprocessing",
    "question": "How does get_stopwords() differ from load_stopwords()?",
    "reference_answer": "load_stopwords() loads the English stopword list, while get_stopwords() removes the explicitly preserved words from that list.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "load_stopwords loads list",
      "get_stopwords excludes _KEEP_WORDS"
    ],
    "answerable": true
  },
  {
    "id": "Q004",
    "category": "preprocessing",
    "question": "What happens if the NLTK stopwords corpus is missing?",
    "reference_answer": "The loader attempts to download the stopwords corpus quietly and then retries loading it.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "detects missing corpus",
      "quiet download",
      "retry load"
    ],
    "answerable": true
  },
  {
    "id": "Q005",
    "category": "preprocessing",
    "question": "What happens if NLTK cannot be imported?",
