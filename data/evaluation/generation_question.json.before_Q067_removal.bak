      "get_stopwords"
    ],
    "answerable": true
  },
  {
    "id": "Q011",
    "category": "preprocessing",
    "question": "How does remove_stopwords() split and rebuild text?",
    "reference_answer": "It splits the text on whitespace, filters out tokens matching stopwords, and joins the remaining tokens with spaces.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "split whitespace",
      "filter stopwords",
      "join with spaces"
    ],
    "answerable": true
  },
  {
    "id": "Q012",
    "category": "preprocessing",
    "question": "What does normalize_whitespace() return?",
    "reference_answer": "It collapses repeated whitespace and strips leading and trailing whitespace.",
