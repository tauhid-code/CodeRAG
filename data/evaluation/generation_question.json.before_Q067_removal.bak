  },
  {
    "id": "Q008",
    "category": "preprocessing",
    "question": "What is the high-level order of operations in preprocess_text()?",
    "reference_answer": "It lowercases the text, removes special characters, optionally removes stopwords, and normalizes whitespace.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "lowercase",
      "special-character removal",
      "optional stopword removal",
      "whitespace normalization"
    ],
    "answerable": true
  },
  {
    "id": "Q009",
    "category": "preprocessing",
    "question": "What does the remove_stops argument control?",
    "reference_answer": "It determines whether preprocess_text() applies stopword removal; when false, that step is skipped.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
      "controls stopword step",
      "false skips removal"
    ],
    "answerable": true
  },
  {
    "id": "Q010",
    "category": "preprocessing",
    "question": "What does remove_stopwords() do when stop_words is omitted?",
    "reference_answer": "It obtains the default stopword set through get_stopwords() and uses it to filter the text.",
    "source_files": [
      "src/preprocessing.py"
    ],
    "expected_points": [
