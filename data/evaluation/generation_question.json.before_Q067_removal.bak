      "src/preprocessing.py"
    ],
    "expected_points": [
      "collapse repeated whitespace",
      "strip ends"
    ],
    "answerable": true
  },
  {
    "id": "Q013",
    "category": "preprocessing",
    "question": "How does tokenize() form tokens?",
    "reference_answer": "It splits the text on whitespace and retains tokens whose length is greater than one.",
